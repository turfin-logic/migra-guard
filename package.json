{
    "name": "migra-guard",
    "version": "1.0.0",
    "description": "Conservative PostgreSQL migration linter for DROP TABLE and NOT NULL column additions",
    "main": "dist/cli.js",
    "bin": {
        "migra-guard": "./dist/cli.js"
    },
    "scripts": {
        "build": "tsc",
        "start": "node dist/cli.js",
        "test": "npm run build && jest --runInBand",
        "typecheck": "tsc --noEmit",
        "prepack": "npm run build"
    },
    "keywords": [
        "postgresql",
        "migrations",
        "lint"
    ],
    "author": "",
    "license": "ISC",
    "type": "commonjs",
    "dependencies": {
        "commander": "^12.0.0",
        "chalk": "6.0.0",
        "node-sql-parser": "^5.2.0"
    },
    "devDependencies": {
        "typescript": "5.4.5",
        "ts-jest": "^29.1.2",
        "jest": "^29.7.0",
        "@types/node": "^20.11.30",
        "@types/jest": "^29.5.12"
    },
    "engines": {
        "node": ">=22.14.0"
    },
    "files": [
        "dist/",
        "README.md",
        "LICENSE",
        "docs/claim-evidence.md"
    ]
}
